{
  "name": "island-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "beta": "vite preview --host 127.0.0.1",
    "preview": "vite preview --host 0.0.0.0",
    "server": "node server/index.js",
    "test": "node --test",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/build-apk.ps1 -BuildType Debug",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/build-apk.ps1 -BuildType Release",
    "android:key": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/android/create-release-key.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@dgreenheck/ez-tree": "^1.1.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "vite": "^7.1.0"
  }
}
